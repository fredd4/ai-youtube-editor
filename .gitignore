# Environment / secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Project working data: a project is the user's own footage, transcripts and
# cut — none of it belongs in the tool's repository. Nothing under projects/
# is tracked except the directory itself.
projects/*
!projects/.gitkeep

# Media files anywhere
*.mp4
*.mov
*.m4v
*.wav
*.mp3
*.aac

# Test artifacts
tests/fixtures/generated/

# Symlinks to unrelated repos kept for reference
other_projects/

# macOS
.DS_Store

# Runtime state
